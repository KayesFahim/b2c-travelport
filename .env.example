# Public configuration only; never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APP_URL=http://localhost:3000

# MySQL and shared Redis are required for production authentication.
DATABASE_URL=mysql://flyjatt:CHANGE_ME@127.0.0.1:3306/flyjatt_booking
REDIS_URL=redis://127.0.0.1:6379
JWT_SESSION_SECRET=
# Optional service-to-service key. Never expose this in a browser bundle.
API_KEY=
# Enable only behind an ingress that overwrites X-Forwarded-For.
TRUST_PROXY=false
EMAIL_VERIFICATION_REQUIRED=true
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Travelport pre-production endpoints. Obtain approved live endpoints before launch.
TRAVELPORT_AUTH_URL=https://auth.pp.travelport.net/oauth/token
TRAVELPORT_AUTH_GRANT_TYPE=password
TRAVELPORT_CLIENT_ID=
TRAVELPORT_CLIENT_SECRET=
TRAVELPORT_USERNAME=
TRAVELPORT_PASSWORD=
TRAVELPORT_ACCESS_GROUP=
TRAVELPORT_VERSION=11
TRAVELPORT_BASE_URL=https://api.pp.travelport.net
TRAVELPORT_FLIGHTS_URL=https://api.pp.travelport.net/11/air/catalog/search/catalogproductofferings
TRAVELPORT_AIR_PRICE=https://api.pp.travelport.net/11/air/price/offers/buildfromproducts
TRAVELPORT_AIR_BOOKING=https://api.pp.travelport.net/11/air/book
TRAVELPORT_FARE_RULES=https://api.pp.travelport.net/11/air/farerule/farerules/fromoffer
TRAVELPORT_VIEW_SEAT_MAP=https://api.pp.travelport.net/11/air/search/seat/catalogofferingsancillaries/seatavailabilities
TRAVELPORT_SHOP_ANCILLARY=https://api.pp.travelport.net/11/air/ancillaryshop/catalogofferingsancillaries
TRAVELPORT_MAX_UPSELLS_TO_RETURN=4
TRAVELPORT_SAVE_SEARCH_RESPONSE=false
TRAVELPORT_ISSUE_TICKET_ENABLE_FORM_OF_PAYMENT=false
TRAVELPORT_ISSUE_TICKET_ENABLE_APPLY_PAYMENT=false

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
NOREPLY_EMAIL=
NOREPLY_PASSWORD=
BOOKING_EMAIL=
BOOKING_PASSWORD=
TICKET_EMAIL=
TICKET_PASSWORD=
CONTACT_EMAIL=
CONTACT_PASSWORD=
CUSTOMER_EMAIL=

# Comma-separated HTTPS object-storage origins approved for passport OCR downloads.
# Empty disables remote downloads; authenticated base64 uploads remain available.
PASSPORT_IMAGE_ORIGINS=
PASSPORT_OCR_TIMEOUT_MS=55000
BLOB_READ_WRITE_TOKEN=
