generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PREPARED
  BOOKED
  FAILED
  CANCELLED
  COMMITTED
  TICKETED
}

model User {
  id                     Int           @id @default(autoincrement())
  email                  String        @unique
  name                   String?
  givenName              String?
  surName                String?
  address                String?
  phone                  String?
  dateOfBirth            DateTime?
  passportNumber         String?
  passportIssuingCountry String?
  passportExpiryDate     DateTime?
  nationality            String?
  gender                 String?
  passwordHash           String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  bookings               Booking[]
  travelBuddies          TravelBuddy[]
}

model Booking {
  id              Int                @id @default(autoincrement())
  userId          Int
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingFlowKey  String?            @unique
  bookingOfferKey String?
  reservationId   String?            @unique
  locator         String?
  status          BookingStatus      @default(PREPARED)
  routeKey        String
  airlineCode     String
  travelDate      DateTime
  flightSignature String
  departureCode   String?
  arrivalCode     String?
  totalFare       Float?
  currencyCode    String?
  rawPreview      Json?
  rawCommit       Json?
  payloadSnapshot Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  passengers      BookingPassenger[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, flightSignature, travelDate, airlineCode])
}

model BookingPassenger {
  id                     Int       @id @default(autoincrement())
  bookingId              Int
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paxType                String
  prefix                 String?
  firstName              String?
  lastName               String?
  birthDate              DateTime?
  passportNumber         String?
  passportIssuingCountry String?
  passportExpiryDate     DateTime?
  nationality            String?
  gender                 String?
  phone                  String?
  email                  String?
  createdAt              DateTime  @default(now())

  @@index([bookingId, paxType])
}

model TravelBuddy {
  id                 Int       @id @default(autoincrement())
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  firstName          String?
  lastName           String?
  paxtype            String?
  gender             String?
  nationality        String?
  dateOfBirth        DateTime?
  passportNumber     String?
  passportExpiryDate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, passportNumber])
}

model BlogPost {
  id         Int      @id @default(autoincrement())
  title      String
  tag        String   @default("Travel Tips")
  excerpt    String?  @db.Text
  content    String?  @db.LongText
  imageUrl   String?
  published  Boolean  @default(true)
  authorName String?  @default("FlyJatt Team")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, createdAt])
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  section   String
  key       String
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}
