generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PREPARED
  BOOKED
  FAILED
  CANCELLED
  COMMITTED
  TICKETED
}

enum AccessRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
  RESERVATION
}

model User {
  id                     Int           @id @default(autoincrement())
  email                  String        @unique
  name                   String?
  givenName              String?
  surName                String?
  address                String?
  phone                  String?
  dateOfBirth            DateTime?
  passportNumber         String?
  passportIssuingCountry String?
  passportExpiryDate     DateTime?
  nationality            String?
  gender                 String?
  admin                  Boolean       @default(false)
  role                   AccessRole    @default(CUSTOMER)
  passwordHash           String
  emailVerified          Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  bookings               Booking[]
  travelBuddies          TravelBuddy[]

  @@index([admin, role])
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String?
  passwordHash String
  role         AccessRole @default(ADMIN)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role, isActive])
}

model Booking {
  id              Int                @id @default(autoincrement())
  userId          Int
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripType        String?
  bookingFlowKey  String?            @unique
  bookingOfferKey String?
  reservationId   String?            @unique
  locator         String?
  status          BookingStatus      @default(PREPARED)
  routeKey        String
  airlineCode     String
  travelDate      DateTime           @db.Date
  flightSignature String
  departureCode   String?
  arrivalCode     String?
  totalFare       Float?
  currencyCode    String?
  rawPreview      Json?
  rawCommit       Json?
  payloadSnapshot Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  passengers      BookingPassenger[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([userId, flightSignature, travelDate, airlineCode])
}

model BookingPassenger {
  id                     Int       @id @default(autoincrement())
  bookingId              Int
  booking                Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paxType                String
  prefix                 String?
  firstName              String?
  lastName               String?
  birthDate              DateTime? @db.Date
  passportNumber         String?
  passportIssuingCountry String?
  passportExpiryDate     DateTime? @db.Date
  nationality            String?
  gender                 String?
  phone                  String?
  email                  String?
  createdAt              DateTime  @default(now())

  @@index([bookingId, paxType])
}

model TravelBuddy {
  id                 Int       @id @default(autoincrement())
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  firstName          String?
  lastName           String?
  paxtype            String?
  gender             String?
  nationality        String?
  dateOfBirth        DateTime? @db.Date
  passportNumber     String?
  passportExpiryDate DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, passportNumber])
}

model BlogPost {
  id         Int      @id @default(autoincrement())
  title      String
  tag        String   @default("Travel Tips")
  excerpt    String?  @db.Text
  content    String?  @db.LongText
  imageUrl   String?
  published  Boolean  @default(true)
  authorName String?  @default("FlyJatt Team")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, createdAt])
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  section   String
  key       String
  value     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, key])
  @@index([section])
}

model SearchLog {
  id                 Int      @id @default(autoincrement())
  timestamp          DateTime
  mode               String
  userId             Int?
  status             String
  route              String   @db.Text
  cabinClass         String
  segments           Int
  ipHash             String
  browserFingerprint String
  visitorId          String?
  count              Int?
  limit              Int?
  remaining          Int?
  bookingCount       Int?
  message            String?  @db.Text
  importKey          String?  @unique
  createdAt          DateTime @default(now())

  @@index([timestamp])
  @@index([status, timestamp])
  @@index([mode, timestamp])
  @@index([userId, timestamp])
}

model BookingLog {
  id                  Int      @id @default(autoincrement())
  timestamp           DateTime
  outcome             String
  stage               String?
  status              Int?
  message             String?  @db.Text
  details             String?  @db.Text
  reservationId       String?
  bookingFlowKey      String?
  bookingOfferKey     String?
  offerIdentifiers    Json?
  warnings            Json?
  commitRequested     Boolean  @default(false)
  commitOnlyRequested Boolean  @default(false)
  importKey           String?  @unique
  createdAt           DateTime @default(now())

  @@index([timestamp])
  @@index([outcome, timestamp])
  @@index([reservationId, timestamp])
  @@index([stage, timestamp])
}

model AirlineMarkup {
  id            Int      @id @default(autoincrement())
  airlineCode   String   @unique
  airlineName   String?
  markupType    String   @default("PERCENTAGE")
  markupValue   Float    @default(0)
  discountType  String   @default("PERCENTAGE")
  discountValue Float    @default(0)
  isActive      Boolean  @default(true)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([airlineCode, isActive])
}
